<?xml version="1.0" encoding="utf-8"?>
<!-- Side-loaded build: no accessibility service. Play Protect blocks side-loaded APKs that carry one ("can request access to sensitive data"); the Reels/Shorts zap is in the Play build. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <service android:name=".monitor.ShortsGuard" tools:node="remove" />
    </application>
</manifest>
