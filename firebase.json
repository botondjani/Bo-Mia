{
  "hosting": {
    "public": "docs",
    "ignore": [
      "firebase.json",
      "plan/**",
      "play/**",
      "**/*.md",
      "img/**/*.psd"
    ],
    "cleanUrls": true,
    "trailingSlash": true,
    "headers": [
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    ]
  }
}